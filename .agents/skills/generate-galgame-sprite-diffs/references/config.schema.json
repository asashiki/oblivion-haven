{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/galgame-sprite-diffs/config.schema.json",
  "title": "Galgame Sprite Difference Generator Config",
  "type": "object",
  "required": [
    "schema_version",
    "character",
    "render",
    "pose_design",
    "chroma_key",
    "poses",
    "expressions",
    "runtime",
    "qa",
    "workflow",
    "output"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 3 },
    "character": {
      "type": "object",
      "required": ["slug", "description", "reference_images", "style_note", "preserve", "avoid"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
        "description": { "type": "string" },
        "reference_images": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              {
                "type": "object",
                "required": ["path", "role"],
                "properties": {
                  "path": { "type": "string", "minLength": 1 },
                  "role": {
                    "enum": [
                      "primary-character",
                      "supporting-character",
                      "detail-style",
                      "pose-only"
                    ]
                  },
                  "note": { "type": "string" }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "style_note": { "type": "string" },
        "preserve": { "type": "array", "items": { "type": "string" } },
        "avoid": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "render": {
      "type": "object",
      "required": ["size", "quality", "safe_margin_percent", "anchor", "reference_pose"],
      "properties": {
        "size": { "type": "string", "pattern": "^[1-9][0-9]*x[1-9][0-9]*$" },
        "quality": { "enum": ["low", "medium", "high", "auto"] },
        "safe_margin_percent": { "type": "number", "minimum": 0, "maximum": 25 },
        "anchor": { "enum": ["center", "bottom-center"] },
        "reference_pose": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "pose_design": {
      "type": "object",
      "required": [
        "character_traits",
        "energy",
        "openness",
        "formality",
        "shyness",
        "gesture_amplitude",
        "signature_gesture",
        "side_turn_direction",
        "forbidden_gestures"
      ],
      "properties": {
        "character_traits": { "type": "array", "items": { "type": "string" } },
        "energy": { "type": "number", "minimum": 0, "maximum": 1 },
        "openness": { "type": "number", "minimum": 0, "maximum": 1 },
        "formality": { "type": "number", "minimum": 0, "maximum": 1 },
        "shyness": { "type": "number", "minimum": 0, "maximum": 1 },
        "gesture_amplitude": { "enum": ["very-low", "low", "medium"] },
        "signature_gesture": { "type": "string" },
        "side_turn_direction": { "enum": ["auto", "left", "right"] },
        "forbidden_gestures": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "chroma_key": {
      "type": "object",
      "required": [
        "mode",
        "preferred",
        "candidates",
        "transparent_distance",
        "opaque_distance",
        "edge_radius",
        "scope",
        "soft_matte",
        "despill"
      ],
      "properties": {
        "mode": { "enum": ["auto", "fixed"] },
        "preferred": { "$ref": "#/$defs/hexColor" },
        "candidates": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/hexColor" }
        },
        "transparent_distance": { "type": "number", "minimum": 0, "maximum": 254 },
        "opaque_distance": { "type": "number", "minimum": 1, "maximum": 255 },
        "edge_radius": { "type": "integer", "minimum": 0, "maximum": 16 },
        "scope": { "enum": ["all", "border-connected"] },
        "soft_matte": { "type": "boolean" },
        "despill": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "poses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "label", "instruction", "runtime"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "type": "string", "minLength": 1 },
          "instruction": { "type": "string", "minLength": 1 },
          "runtime": { "$ref": "#/$defs/runtimePolicy" }
        },
        "additionalProperties": false
      }
    },
    "expressions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "label", "pose", "instruction", "runtime"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "type": "string", "minLength": 1 },
          "pose": { "$ref": "#/$defs/id" },
          "instruction": { "type": "string", "minLength": 1 },
          "runtime": { "$ref": "#/$defs/runtimePolicy" }
        },
        "additionalProperties": false
      }
    },
    "runtime": {
      "type": "object",
      "required": ["engine", "mask_feather_px", "states"],
      "properties": {
        "engine": { "const": "webgal-image" },
        "mask_feather_px": { "type": "number", "minimum": 0, "maximum": 24 },
        "states": {
          "type": "object",
          "required": ["eyes_half", "eyes_close", "mouth_half_open", "mouth_open"],
          "properties": {
            "eyes_half": { "type": "string", "minLength": 1 },
            "eyes_close": { "type": "string", "minLength": 1 },
            "mouth_half_open": { "type": "string", "minLength": 1 },
            "mouth_open": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "qa": {
      "type": "object",
      "required": [
        "face_box",
        "variant_retry_limit",
        "outside_face_alpha_iou_warn_below",
        "outside_face_rgb_mean_warn_above",
        "runtime_min_inside_changed_pixels"
      ],
      "properties": {
        "face_box": {
          "type": "array",
          "prefixItems": [
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "number", "minimum": 0, "maximum": 1 }
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "variant_retry_limit": { "type": "integer", "minimum": 0, "maximum": 3 },
        "outside_face_alpha_iou_warn_below": { "type": "number", "minimum": 0, "maximum": 1 },
        "outside_face_rgb_mean_warn_above": { "type": "number", "minimum": 0, "maximum": 255 },
        "runtime_min_inside_changed_pixels": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "required": [
        "pause_after_base",
        "require_explicit_base_approval",
        "pause_after_poses",
        "require_explicit_pose_approval",
        "pause_after_expressions",
        "require_explicit_expression_approval",
        "generate_poses_separately",
        "generate_expressions_separately",
        "generate_runtime_states_separately"
      ],
      "properties": {
        "pause_after_base": { "const": true },
        "require_explicit_base_approval": { "const": true },
        "pause_after_poses": { "const": true },
        "require_explicit_pose_approval": { "const": true },
        "pause_after_expressions": { "const": true },
        "require_explicit_expression_approval": { "const": true },
        "generate_poses_separately": { "const": true },
        "generate_expressions_separately": { "const": true },
        "generate_runtime_states_separately": { "const": true }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": [
        "work_dir",
        "deliverables_dir",
        "keep_chroma_sources",
        "keep_working_files",
        "keep_local_parts",
        "make_contact_sheet",
        "make_demo_gifs"
      ],
      "properties": {
        "work_dir": { "$ref": "#/$defs/relativeDir" },
        "deliverables_dir": { "$ref": "#/$defs/relativeDir" },
        "keep_chroma_sources": { "type": "boolean" },
        "keep_working_files": { "type": "boolean" },
        "keep_local_parts": { "type": "boolean" },
        "make_contact_sheet": { "type": "boolean" },
        "make_demo_gifs": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "hexColor": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "relativeDir": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
    },
    "runtimePolicy": {
      "type": "object",
      "required": ["blink", "mouth_sync", "extra_states", "mask_profile"],
      "properties": {
        "blink": { "enum": ["dynamic", "fixed-open", "fixed-closed"] },
        "mouth_sync": { "type": "boolean" },
        "extra_states": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["eyes_half"] }
        },
        "mask_profile": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
