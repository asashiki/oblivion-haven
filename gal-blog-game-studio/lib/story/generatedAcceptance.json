        ]
      }
    },
    {
      "id": "scene_7f6b7a36",
      "chapterId": "chapter_one",
      "name": "02A · 先说今天",
      "slug": "02a-先说今天",
      "mode": "adv",
      "tags": [
        "ai-generated-acceptance",
        "three-real-assets"
      ],
      "blocks": [
        {
          "id": "stage_cb93a4f1",
          "source": "ai",
          "type": "stage",
          "action": "set-background",
          "assetId": "bg_alice_tea_room_day",
          "transition": {
            "name": "enter",
            "durationMs": 500
          }
        },
        {
          "id": "dialogue_5e12a598",
          "source": "ai",
          "type": "dialogue",
          "characterId": "char_alice",
          "text": "那就从今天开始。不用从最正确的地方开始。",
          "expressionId": "expr_alice_standard_normal",
          "position": "left",
          "enter": {
            "name": "enter-from-left",
            "durationMs": 520,
            "easing": "easeOut"
          }
        },
        {
          "id": "dialogue_0381ef80",
          "source": "ai",
          "type": "dialogue",
          "characterId": "char_alice",
          "text": "你可以只告诉我，哪一个瞬间最想立刻离开。"
        },
        {
          "id": "dialogue_bc1463f7",
          "source": "ai",
          "type": "dialogue",
          "characterId": "char_alice",
          "text": "……原来如此。你不是不知道该怎么做，只是不想让任何人失望。"
        },
        {
          "id": "dialogue_65ebb10d",
          "source": "ai",
          "type": "dialogue",
          "characterId": "char_alice",
          "text": "可如果连你自己也被排在最后，这份体贴迟早会变成一张没人敢拆的欠条。"
        },
        {
          "id": "dialogue_96467a19",
          "source": "ai",
          "type": "dialogue",
          "characterId": "char_alice",
          "text": "要继续说下去，还是先回到茶桌旁？两种都不算逃避。"
        },
        {
          "id": "choice_2f0b8e3f",
          "source": "ai",
          "type": "choice",
          "options": [
            {
              "id": "confession_promise",
              "label": "把真正担心的事说完",
              "targetSceneId": "scene_d43796bc"
            },
            {
              "id": "confession_tea",
              "label": "先去看看红茶",
              "targetSceneId": "scene_9c044876"
            }
          ],
          "prompt": "把话说到哪一步？"
        }
      ],
      "aiContext": "主人试着说明今天的迟疑，爱丽丝没有催促，只把问题缩小到可以回答的程度。只使用已登记的三份真实素材；没有 BGM，因此保持静音。",
      "summary": "主人试着说明今天的迟疑，爱丽丝没有催促，只把问题缩小到可以回答的程度",
      "entryStage": {
        "backgroundAssetId": "bg_alice_tea_room_day",
