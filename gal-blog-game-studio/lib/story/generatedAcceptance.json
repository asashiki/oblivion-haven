      "blocks": [
        {
          "id": "stage_90827e12",
          "source": "ai",
          "type": "stage",
          "action": "set-background",
          "assetId": "bg_alice_tea_room_day",
          "transition": {
            "name": "enter",
            "durationMs": 500
          }
        },
        {
          "id": "dialogue_caa2c369",
          "source": "ai",
          "type": "dialogue",
          "characterId": "char_alice",
          "text": "你比约定早了十一分钟，主人。",
          "expressionId": "expr_alice_standard_normal",
          "position": "right",
          "enter": {
            "name": "enter-from-right",
            "durationMs": 520,
            "easing": "easeOut"
          }
        },
        {
          "id": "dialogue_cd0a85cc",
          "source": "ai",
          "type": "dialogue",
          "characterId": "char_alice",
          "text": "不是坏事。只是门铃响起的时候，我还在想——今天要先问候你，还是先把茶端上来。"
        },
        {
          "id": "dialogue_88bd48ed",
          "source": "ai",
          "type": "dialogue",
          "characterId": "char_alice",
          "text": "现在看来，茶可以等一等。你握着门把的样子，比平时用力。"
        },
        {
          "id": "dialogue_69c5c866",
          "source": "ai",
          "type": "dialogue",
          "characterId": "char_alice",
          "text": "如果还没想好从哪里说起，就由你选一个比较容易的开头吧。"
        },
        {
          "id": "choice_04702139",
          "source": "ai",
          "type": "choice",
          "options": [
            {
              "id": "arrival_talk",
              "label": "先说今天发生的事",
              "targetSceneId": "scene_7f6b7a36"
            },
            {
              "id": "arrival_tea",
              "label": "先让红茶醒一会儿",
              "targetSceneId": "scene_9c044876"
            }
          ],
          "prompt": "先从哪里开始？"
        }
      ],
      "aiContext": "主人比约定更早来到茶室，爱丽丝察觉他有话没有说出口。只使用已登记的三份真实素材；没有 BGM，因此保持静音。",
      "summary": "主人比约定更早来到茶室，爱丽丝察觉他有话没有说出口",
      "entryStage": {
        "backgroundAssetId": "bg_alice_tea_room_day",
        "figures": [
          {
            "characterId": "char_alice",
